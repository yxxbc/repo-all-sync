{
  "name": "repo-all-sync",
  "version": "0.2.1",
  "description": "Sync a git repository to GitHub, Gitee and CNB — mirror repos, source pushes and release assets.",
  "type": "module",
  "bin": {
    "repo-all-sync": "bin/repo-all-sync.mjs"
  },
  "files": [
    ".claude-plugin",
    "bin",
    "src",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "check": "node --check bin/repo-all-sync.mjs && bash -n bin/repo-all-sync && node --check src/cli.mjs",
    "plugin:validate": "claude plugin validate ."
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "git",
    "mirror",
    "gitee",
    "cnb",
    "github",
    "release",
    "cli",
    "sync"
  ],
  "license": "MIT",
  "author": "Xynrin",
  "homepage": "https://github.com/yxxbc/repo-all-sync#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yxxbc/repo-all-sync.git"
  },
  "bugs": {
    "url": "https://github.com/yxxbc/repo-all-sync/issues"
  }
}
